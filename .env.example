# Copy this file to .env and replace the placeholder with your own key.
# Never commit .env or expose the real key in logs, issues, or chat.

AMAP_MAPS_API_KEY=your_amap_web_service_key_here
AMAP_MCP_TIMEOUT_SECONDS=20
AMAP_MCP_MAX_RETRIES=1
AMAP_MCP_MAX_CONCURRENCY=4
AMAP_MCP_MIN_INTERVAL_SECONDS=0.5

# Community 12306 MCP (query-only; no login, ticket grabbing, or ordering).
# Requires Node.js 18+ and npx. Keep the package pinned for reproducible demos.
RAILWAY_MCP_ENABLED=true
RAILWAY_MCP_PACKAGE=12306-mcp@0.3.10
RAILWAY_MCP_TIMEOUT_SECONDS=40
RAILWAY_MCP_MAX_RETRIES=1
RAILWAY_MCP_MAX_CONCURRENCY=2
RAILWAY_MCP_CANDIDATE_LIMIT=20

# VariFlight MCP (query-only; no booking or writes).
# Set enabled=true only after replacing the placeholder in your private .env.
VARIFLIGHT_MCP_ENABLED=false
VARIFLIGHT_API_KEY=your_variflight_api_key_here
VARIFLIGHT_MCP_PACKAGE=@variflight-ai/variflight-mcp@1.0.3
VARIFLIGHT_MCP_TIMEOUT_SECONDS=40
VARIFLIGHT_MCP_MAX_RETRIES=1
VARIFLIGHT_MCP_MAX_CONCURRENCY=2
VARIFLIGHT_MCP_CANDIDATE_LIMIT=80

# Lodging POIs are live AMap facts, but room prices are not OTA quotes.
# Leave price empty for an explicit rating-tier estimate, or enter your own nightly price.
LODGING_NIGHTLY_PRICE_CNY=
LODGING_CANDIDATE_LIMIT=3

# Local TTL cache and aggregate metrics. No prompts or API keys are stored.
TRIPWEAVER_DATABASE_PATH=.tripweaver/tripweaver.db
TRIPWEAVER_CACHE_ENABLED=true
TRIPWEAVER_CACHE_TTL_SECONDS=90
TRIPWEAVER_METRICS_ENABLED=true
# Optional DeepSeek JSON Output interpreter. Deterministic parsing remains the fallback.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
